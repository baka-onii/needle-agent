# Set these in the environment before starting needle-agent.
# This file is documentation; it is not automatically loaded.
NEEDLE_WORKSPACE=examples/workspace
NEEDLE_LLM_BASE_URL=http://127.0.0.1:8080
NEEDLE_LLM_MODEL=ornith
# Optional provider authentication (keep real values out of Git):
# NEEDLE_LLM_API_KEY=
# Optional offline Needle library / custom weights:
# NEEDLE_LIB_PATH=/absolute/path/to/libneedle.so
# NEEDLE_WEIGHTS=/absolute/path/to/model.cact
NEEDLE_TELEMETRY=0
